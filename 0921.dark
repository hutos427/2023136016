# 2023136016
import 'dart:math';

import 'package:flutter/material.dart';

void main() {
  runApp(const CalculatorApp());
}

class CalculatorApp extends StatelessWidget {
  const CalculatorApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: '계산기',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: const Color(0xFF0067C0)),
        useMaterial3: true,
      ),
      home: const CalculatorHomePage(),
    );
  }
}

class CalculatorHomePage extends StatefulWidget {
  const CalculatorHomePage({super.key});

  @override
  State<CalculatorHomePage> createState() => _CalculatorHomePageState();
}

class _CalculatorHomePageState extends State<CalculatorHomePage> {
  String _display = '0'; // 현재 입력/결과 숫자
  String _expression = ''; // 상단에 표시될 계산식 (예: "12 + 5 =")
  double? _firstOperand;
  String? _operator;
  bool _shouldResetDisplay = false;

  void _onButtonPressed(String value) {
    setState(() {
      if (int.tryParse(value) != null) {
        // 숫자 입력
        if (_display == '0' || _shouldResetDisplay) {
          _display = value;
          _shouldResetDisplay = false;
        } else {
          _display += value;
        }
      } else if (value == '.') {
        // 소수점 입력
        if (_shouldResetDisplay) {
          _display = '0.';
          _shouldResetDisplay = false;
        } else if (!_display.contains('.')) {
          _display += '.';
        }
      } else if (value == 'C') {
        // 전체 초기화
        _display = '0';
        _expression = '';
        _firstOperand = null;
        _operator = null;
        _shouldResetDisplay = false;
      } else if (value == 'CE') {
        // 현재 입력값만 초기화
        _display = '0';
      } else if (value == '⌫') {
        // 백스페이스
        if (_display.length > 1) {
          _display = _display.substring(0, _display.length - 1);
        } else {
          _display = '0';
        }
      } else if (value == '+/-') {
        // 부호 전환
        if (_display != '0') {
          if (_display.startsWith('-')) {
            _display = _display.substring(1);
          } else {
            _display = '-$_display';
          }
        }
      } else if (value == '%') {
        final current = double.tryParse(_display) ?? 0;
        _expression = 'sqr($_display)';
        _display = _formatResult(current / 100);
        _shouldResetDisplay = true;
      } else if (value == '1/x') {
        final current = double.tryParse(_display) ?? 0;
        _expression = '1/($_display)';
        if (current == 0) {
          _display = '0으로 나눌 수 없습니다';
        } else {
          _display = _formatResult(1 / current);
        }
        _shouldResetDisplay = true;
      } else if (value == 'x²') {
        final current = double.tryParse(_display) ?? 0;
        _expression = 'sqr($_display)';
        _display = _formatResult(current * current);
        _shouldResetDisplay = true;
      } else if (value == '²√x') {
        final current = double.tryParse(_display) ?? 0;
        _expression = '√($_display)';
        if (current < 0) {
          _display = '잘못된 입력입니다';
        } else {
          _display = _formatResult(sqrt(current));
        }
        _shouldResetDisplay = true;
      } else if (value == '+' || value == '–' || value == '×' || value == '÷') {
        // 사칙연산자 눌렀을 때 계산식 갱신
        _firstOperand = double.tryParse(_display);
        _operator = value;
        _expression = '$_display $value';
        _shouldResetDisplay = true;
      } else if (value == '=') {
        // 등호(=) 눌렀을 때 전체 계산식 완성 후 결과 계산
        if (_firstOperand != null && _operator != null) {
          final secondOperand = double.tryParse(_display) ?? 0;
          double result = 0;

          _expression = '$_firstOperand $_operator $_display =';

          switch (_operator) {
            case '+':
              result = _firstOperand! + secondOperand;
              break;
            case '–':
              result = _firstOperand! - secondOperand;
              break;
            case '×':
              result = _firstOperand! * secondOperand;
              break;
            case '÷':
              if (secondOperand == 0) {
                _display = '0으로 나눌 수 없습니다';
                _firstOperand = null;
                _operator = null;
                _shouldResetDisplay = true;
                return;
              }
              result = _firstOperand! / secondOperand;
              break;
          }

          _display = _formatResult(result);
          _firstOperand = null;
          _operator = null;
          _shouldResetDisplay = true;
        }
      }
    });
  }

  String _formatResult(double val) {
    if (val % 1 == 0) {
      return val.toInt().toString();
    }
    return val.toString();
  }

  @override
  Widget build(BuildContext context) {
    final List<List<Map<String, dynamic>>> buttonGrid = [
      [
        {'label': '%'},
        {'label': 'CE'},
        {'label': 'C'},
        {'label': '⌫'},
      ],
      [
        {'label': '1/x'},
        {'label': 'x²'},
        {'label': '²√x'},
        {'label': '÷'},
      ],
      [
        {'label': '7', 'isNumber': true},
        {'label': '8', 'isNumber': true},
        {'label': '9', 'isNumber': true},
        {'label': '×'},
      ],
      [
        {'label': '4', 'isNumber': true},
        {'label': '5', 'isNumber': true},
        {'label': '6', 'isNumber': true},
        {'label': '–'},
      ],
      [
        {'label': '1', 'isNumber': true},
        {'label': '2', 'isNumber': true},
        {'label': '3', 'isNumber': true},
        {'label': '+'},
      ],
      [
        {'label': '+/-'},
        {'label': '0', 'isNumber': true},
        {'label': '.'},
        {'label': '=', 'isPrimary': true},
      ],
    ];

    return Scaffold(
      backgroundColor: const Color(0xFFEBF5EE),
      body: SafeArea(
        child: Column(
          children: [
            // 2. 디스플레이 영역 (계산식 + 현재 입력/결과값)
            Expanded(
              child: Container(
                width: double.infinity,
                padding: const EdgeInsets.symmetric(
                  horizontal: 20.0,
                  vertical: 8.0,
                ),
                alignment: Alignment.bottomRight,
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.end,
                  crossAxisAlignment: CrossAxisAlignment.end,
                  children: [
                    // 위쪽에 나타나는 입력 중인 계산식 (예: 12 + 5 =)
                    FittedBox(
                      fit: BoxFit.scaleDown,
                      alignment: Alignment.centerRight,
                      child: Text(
                        _expression,
                        style: const TextStyle(
                          fontSize: 20,
                          color: Colors.black54,
                          fontWeight: FontWeight.w400,
                        ),
                      ),
                    ),
                    const SizedBox(height: 4),
                    // 아래쪽에 크게 표시되는 숫자
                    FittedBox(
                      fit: BoxFit.scaleDown,
                      alignment: Alignment.centerRight,
                      child: Text(
                        _display,
                        style: const TextStyle(
                          fontSize: 56,
                          fontWeight: FontWeight.w400,
                          color: Colors.black,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),

            // 3. 메모리 라인
            Padding(
              padding: const EdgeInsets.symmetric(
                horizontal: 8.0,
                vertical: 4.0,
              ),
              child: Row(mainAxisAlignment: MainAxisAlignment.spaceAround),
            ),
            const SizedBox(height: 4),

            // 4. 키패드 영역
            Expanded(
              flex: 2,
              child: Padding(
                padding: const EdgeInsets.all(6.0),
                child: Column(
                  children: buttonGrid.map((row) {
                    return Expanded(
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: row.map((btn) {
                          final isNumber = btn['isNumber'] == true;
                          final isPrimary = btn['isPrimary'] == true;

                          return Expanded(
                            child: Padding(
                              padding: const EdgeInsets.all(2.0),
                              child: ElevatedButton(
                                style: ElevatedButton.styleFrom(
                                  backgroundColor: isPrimary
                                      ? const Color(0xFF0067C0)
                                      : (isNumber
                                            ? Colors.white
                                            : const Color(0xFFF3F8F4)),
                                  foregroundColor: isPrimary
                                      ? Colors.white
                                      : Colors.black,
                                  elevation: 0.5,
                                  shape: RoundedRectangleBorder(
                                    borderRadius: BorderRadius.circular(4),
                                    side: BorderSide(
                                      color: Colors.black.withOpacity(0.05),
                                      width: 1,
                                    ),
                                  ),
                                  padding: EdgeInsets.zero,
                                ),
                                onPressed: () => _onButtonPressed(btn['label']),
                                child: Text(
                                  btn['label'],
                                  style: TextStyle(
                                    fontSize: 18,
                                    fontWeight: isNumber || isPrimary
                                        ? FontWeight.w600
                                        : FontWeight.normal,
                                  ),
                                ),
                              ),
                            ),
                          );
                        }).toList(),
                      ),
                    );
                  }).toList(),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _MemoryButton extends StatelessWidget {
  const _MemoryButton({required this.label, this.enabled = true});

  final String label;
  final bool enabled;

  @override
  Widget build(BuildContext context) {
    return Text(
      label,
      style: TextStyle(
        fontSize: 12,
        fontWeight: FontWeight.w600,
        color: enabled ? Colors.black87 : Colors.black26,
      ),
    );
  }
}
